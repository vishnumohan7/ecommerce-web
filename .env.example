# Core
NODE_ENV=development
PORT=3000
# Supavisor transaction pooler for application traffic (IPv4 compatible).
DATABASE_URL=postgresql://postgres.PROJECT_REF:YOUR_PASSWORD@REGION.pooler.supabase.com:6543/postgres?pgbouncer=true
# Supavisor session pooler for Prisma migrations and administrative operations.
DIRECT_URL=postgresql://postgres.PROJECT_REF:YOUR_PASSWORD@REGION.pooler.supabase.com:5432/postgres
REDIS_URL=redis://localhost:6379
TENANCY_MODE=single
DEFAULT_TENANT_ID=00000000-0000-4000-8000-000000000001
JWT_ACCESS_SECRET=replace-with-at-least-32-random-characters
JWT_ISSUER=denes-commerce
AGE_GATE_SECRET=replace-with-a-separate-32-character-secret
CORS_ORIGINS=http://localhost:3001,http://localhost:3002,http://localhost:3003
# Payments
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
# Age verification
AGE_VERIFY_PROVIDER=stub
YOTI_CLIENT_SDK_ID=
YOTI_KEY_FILE_PATH=
YOTI_WEBHOOK_SECRET=
# Address, messaging and notifications
ADDRESS_PROVIDER=static
GETADDRESS_API_KEY=
EMAIL_PROVIDER=mailpit
RESEND_API_KEY=
EMAIL_FROM=
EMAIL_REPLY_TO=
SMS_PROVIDER=console
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_VERIFY_SERVICE_SID=
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=
WHATSAPP_ENABLED=false
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_TOKEN=
# Storage and images
STORAGE_ENDPOINT=http://localhost:9000
STORAGE_BUCKET=denes
STORAGE_ACCESS_KEY=denes
STORAGE_SECRET_KEY=denes-development
STORAGE_PUBLIC_BASE_URL=http://localhost:9000/denes
IMAGE_PROVIDER=sharp
CF_IMAGES_TOKEN=
# Search, dispatch and maps
SEARCH_PROVIDER=postgres
MEILI_HOST=http://localhost:7700
MEILI_MASTER_KEY=denes-development
DISPATCH_PROVIDER=internal
STUART_CLIENT_ID=
STUART_CLIENT_SECRET=
GEO_PROVIDER=fixture
MAPBOX_TOKEN=
# Observability, analytics and flags
SENTRY_DSN=
SENTRY_ENVIRONMENT=development
OTEL_EXPORTER_OTLP_ENDPOINT=
ANALYTICS_PROVIDER=noop
POSTHOG_KEY=
POSTHOG_HOST=
FLAG_PROVIDER=env
FLAGSMITH_KEY=
# Documents, accounting and optional integrations
PDF_RENDERER=puppeteer
ACCOUNTING_PROVIDER=csv
XERO_CLIENT_ID=
XERO_CLIENT_SECRET=
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET=
TRUSTPILOT_API_KEY=
SUPPORT_WIDGET_PROVIDER=noop
