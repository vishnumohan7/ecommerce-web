    "seed:minimal": "tsx prisma/seed-minimal.ts",
    "seed:demo": "tsx prisma/seed-demo.ts"
  },
  "dependencies": {
    "@nestjs/common": "^11.1.2",
    "@nestjs/core": "^11.1.2",
    "@nestjs/jwt": "^11.0.1",
    "@nestjs/platform-express": "^11.1.2",
    "@nestjs/swagger": "^11.2.0",
    "@opentelemetry/api": "^1.9.0",
    "@prisma/client": "6.19.2",
    "@sentry/node": "^10.22.0",
    "argon2": "^0.44.0",
    "bcryptjs": "^3.0.3",
    "bullmq": "^5.61.2",
    "cookie-parser": "^1.4.7",
    "csv-parse": "^6.1.0",
    "dotenv": "^17.2.3",
    "exceljs": "^4.4.0",
    "helmet": "^8.1.0",
    "ioredis": "^5.6.1",
