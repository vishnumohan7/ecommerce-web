    "@types/multer": "^2.0.0",
    "@types/pg": "^8.15.2",
    "@types/supertest": "^6.0.3",
    "@types/swagger-ui-express": "^4.1.8",
    "prisma": "6.19.2",
    "supertest": "^7.1.4",
    "tsx": "^4.23.1",
    "vitest": "^3.2.1"
