generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum UserRole {
  SUPER_ADMIN
  ADMINISTRATOR
  STORE_MANAGER
  CATALOG_MANAGER
  FULFILMENT_STAFF
  CUSTOMER
}

enum ProductStatus {
  DRAFT
  ACTIVE
  INACTIVE
}

enum PricingMode {
  UNIT
  WEIGHT_ESTIMATED
}

enum TaxCategory {
  STANDARD_20
  REDUCED_5
  ZERO
  EXEMPT
}

enum ReturnPolicy {
  STANDARD_14_DAY
  PERISHABLE_EXEMPT
  AGE_RESTRICTED_RESTRICTED
  NON_RETURNABLE
}

enum HfssStatus {
  NOT_IN_SCOPE
  IN_SCOPE
}

enum RestrictionReason {
  NONE
  ALCOHOL
  KNIFE
  TOBACCO
  VAPE
  SOLVENT
  ENERGY_DRINK
  LOTTERY
  RETAILER_POLICY
}

enum CartStatus {
  ACTIVE
  CONVERTED
  ABANDONED
  EXPIRED
}

enum SubstitutionPreference {
  NO_SUB
  SIMILAR
  ANY
}

enum BasketType {
  GROCERY
  ALCOHOL
  MIXED
}

enum OrderCategory {
  GROCERY
  ALCOHOL
}

enum PaymentStatus {
  PENDING
  REQUIRES_ACTION
  AUTHORISED
  CAPTURED
  FAILED
  CANCELLED
  PARTIALLY_REFUNDED
  REFUNDED
}

enum FulfilmentStatus {
  PENDING
  CONFIRMED
  PICKING
  PICKED
  OUT_FOR_DELIVERY
  DELIVERED
  REFUSED
  CANCELLED
}

enum RefundStatus {
  NONE
  PENDING
  PARTIAL
  FULL
  FAILED
}

enum ReturnRequestStatus {
  REQUESTED
  APPROVED
  REJECTED
  REFUND_PENDING
  COMPLETED
}

enum AgeVerificationStatus {
  NOT_REQUIRED
  PENDING
  PASSED
  FAILED
  EXPIRED
  MANUAL_REVIEW
}

enum DeliveryAgeCheckStatus {
  NOT_REQUIRED
  PENDING
  PASSED
  FAILED
  REFUSED
}

enum VerificationOutcome {
  PENDING
  PASSED
  FAILED
  CANCELLED
}

enum AgeVerificationMethod {
  DOB_DECLARATION
  DVS
  MANUAL_REVIEW
}

enum PromotionType {
  PERCENTAGE
  FIXED
  MULTIBUY
  FREE_DELIVERY
}

enum CouponClass {
  CUSTOMER_CREDIT
  SITE_WIDE
  INFLUENCER
}

enum CouponAppliesTo {
  GROCERY
  ALCOHOL
  BOTH
}

enum CheckoutSessionStatus {
  ACTIVE
  INVALIDATED
  EXPIRED
  COMPLETED
  CANCELLED
}

enum PickListStatus {
  OPEN
  IN_PROGRESS
  COMPLETE
  CANCELLED
}

enum SubstitutionStatus {
  PROPOSED
  ACCEPTED
  REJECTED
  EXPIRED
}

enum WebhookStatus {
  RECEIVED
  QUEUED
  PROCESSING
  PROCESSED
  FAILED
}

enum OutboxStatus {
  PENDING
  PROCESSING
  SENT
  DEAD_LETTER
}

enum CmsPageType {
  TERMS
  PRIVACY
  COOKIE
  RETURNS
  ALCOHOL_POLICY
  DELIVERY_POLICY
}

enum ReviewStatus {
  PENDING
  APPROVED
  REJECTED
}

enum ContentBlockType {
  FEATURED_PRODUCTS
  CATEGORY_TILES
  PROMO_BLOCK
}

enum JurisdictionCode {
  ENGLAND_WALES
  SCOTLAND
  NORTHERN_IRELAND
}

enum StorageType {
  AMBIENT
  CHILLED
  FROZEN
}

enum AlcoholType {
  BEER
  WINE
  SPIRITS
  CIDER
  OTHER
}

enum InventoryReason {
  PURCHASE
  SALE
  RESERVATION
  RELEASE
  ADJUSTMENT
  RETURN
  WASTAGE
  PICK_SHORTFALL
}

enum ImportStatus {
  PENDING
  VALIDATING
  READY
  PROCESSING
  COMPLETE
  FAILED
}

model Tenant {
  id        String   @id @default(uuid()) @db.Uuid
  slug      String   @unique
  name      String
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model TenantSettings {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String   @unique @db.Uuid
  settings  Json
  version   Int      @default(1)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId])
}

model BrandingProfile {
  id                String   @id @default(uuid()) @db.Uuid
  tenantId          String   @unique @db.Uuid
  brandName         String
  legalEntityName   String
  companyNumber     String?
  vatNumber         String?
  registeredAddress Json
  assets            Json
  colours           Json
  typography        Json
  emailBranding     Json
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([tenantId])
}

model CmsPage {
  id        String      @id @default(uuid()) @db.Uuid
  tenantId  String      @db.Uuid
  type      CmsPageType
  locale    String      @default("en-GB")
  title     String
  content   String
  published Boolean     @default(false)
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  @@unique([tenantId, type, locale])
  @@index([tenantId])
}

model Banner {
  id             String    @id @default(uuid()) @db.Uuid
  tenantId       String    @db.Uuid
  title          String
  subtitle       String?
  imageUrl       String
  mobileImageUrl String?
  linkUrl        String?
  position       Int       @default(0)
  startsAt       DateTime?
  endsAt         DateTime?
  active         Boolean   @default(true)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([tenantId, active, position])
}

model CmsContentBlock {
  id        String           @id @default(uuid()) @db.Uuid
  tenantId  String           @db.Uuid
  type      ContentBlockType
  title     String?
  content   Json
  position  Int              @default(0)
  startsAt  DateTime?
  endsAt    DateTime?
  active    Boolean          @default(true)
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  @@index([tenantId, active, type, position])
}

model User {
  id           String    @id @default(uuid()) @db.Uuid
  tenantId     String    @db.Uuid
  email        String
  passwordHash String
  firstName    String
  lastName     String
  phone        String?
  role         UserRole  @default(CUSTOMER)
  active       Boolean   @default(true)
  tombstonedAt DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@unique([tenantId, email])
  @@index([tenantId, role])
}

model Address {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String   @db.Uuid
  userId    String   @db.Uuid
  label     String
  line1     String
  line2     String?
  city      String
  postcode  String
  country   String   @default("GB")
  isDefault Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId, userId])
  @@index([tenantId, postcode])
}

model Wishlist {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String   @db.Uuid
  userId    String   @db.Uuid
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([tenantId, userId])
  @@index([tenantId, userId])
}

model WishlistItem {
  id         String   @id @default(uuid()) @db.Uuid
  tenantId   String   @db.Uuid
  wishlistId String   @db.Uuid
  productId  String   @db.Uuid
  createdAt  DateTime @default(now())

  @@unique([tenantId, wishlistId, productId])
  @@index([tenantId, wishlistId, createdAt(sort: Desc)])
  @@index([tenantId, productId])
}

model Jurisdiction {
  id            String           @id @default(uuid()) @db.Uuid
  tenantId      String           @db.Uuid
  code          JurisdictionCode
  name          String
  postcodeAreas String[]         @default([])
  active        Boolean          @default(true)
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  @@unique([tenantId, code])
  @@index([tenantId])
}

model JurisdictionRuleset {
  id                             String   @id @default(uuid()) @db.Uuid
  tenantId                       String   @db.Uuid
  jurisdictionId                 String   @db.Uuid
  permittedSaleStartMinutes      Int
  permittedSaleEndMinutes        Int
  prohibitedDeliveryStartMinutes Int?
  prohibitedDeliveryEndMinutes   Int?
  challengeAge                   Int
  requiresDayBook                Boolean  @default(false)
  allowsDigitalProofOfAge        Boolean  @default(false)
  hfssEnforced                   Boolean  @default(false)
  version                        Int      @default(1)
  createdAt                      DateTime @default(now())
  updatedAt                      DateTime @updatedAt

  @@unique([tenantId, jurisdictionId])
  @@index([tenantId])
}

model Category {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String   @db.Uuid
  parentId  String?  @db.Uuid
  slug      String
  name      String
  imageUrl  String?
  path      String
  position  Int      @default(0)
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([tenantId, slug])
  @@index([tenantId, parentId])
}

model Brand {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String   @db.Uuid
  slug      String
  name      String
  imageUrl  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([tenantId, slug])
  @@index([tenantId])
}

model Product {
  id                   String            @id @default(uuid()) @db.Uuid
  tenantId             String            @db.Uuid
  categoryId           String            @db.Uuid
  brandId              String?           @db.Uuid
  sku                  String
  slug                 String
  name                 String
  description          String
  status               ProductStatus     @default(DRAFT)
  priceMinor           BigInt
  currency             String            @default("GBP")
  vatRateBps           Int
  taxCategory          TaxCategory       @default(ZERO)
  pricingMode          PricingMode       @default(UNIT)
  pricePerKgMinor      BigInt?
  estimatedWeightGrams Int?
  weightToleranceBps   Int?
  isAlcohol            Boolean           @default(false)
  abv                  Decimal?          @db.Decimal(4, 2)
  alcoholType          AlcoholType?
  weightGrams          Int?
  ageRestriction       Int               @default(0)
  restrictionReason    RestrictionReason @default(NONE)
  returnPolicy         ReturnPolicy
  unitPriceDisplay     String
  hfssStatus           HfssStatus        @default(NOT_IN_SCOPE)
  hfssCategory         String?
  dietaryTags          String[]
  allergens            String[]
  countryOfOrigin      String
  storageType          StorageType
  shelfLifeDays        Int?
  ratingAverageBps     Int               @default(0)
  ratingCount          Int               @default(0)
  createdAt            DateTime          @default(now())
  updatedAt            DateTime          @updatedAt

  @@unique([tenantId, sku])
  @@unique([tenantId, slug])
  @@index([tenantId, categoryId, status])
  @@index([tenantId, brandId])
  @@index([tenantId, name])
}

model ProductImage {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String   @db.Uuid
  productId String   @db.Uuid
  variantId String?  @db.Uuid
  url       String
  altText   String
  position  Int      @default(0)
  createdAt DateTime @default(now())

  @@index([tenantId, productId, variantId, position])
  @@index([tenantId, productId])
}

model MediaAsset {
  id          String   @id @default(uuid()) @db.Uuid
  tenantId    String   @db.Uuid
  key         String
  contentType String
  body        Bytes
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([tenantId, key])
  @@index([tenantId, createdAt(sort: Desc)])
}

model Review {
  id               String       @id @default(uuid()) @db.Uuid
  tenantId         String       @db.Uuid
  userId           String       @db.Uuid
  productId        String       @db.Uuid
  orderId          String       @db.Uuid
  rating           Int
  title            String?
  body             String
  imageUrls        String[]
  status           ReviewStatus @default(PENDING)
  moderationReason String?
  moderatedById    String?      @db.Uuid
  moderatedAt      DateTime?
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  @@unique([tenantId, userId, productId])
  @@index([tenantId, productId, status, createdAt(sort: Desc)])
  @@index([tenantId, userId, createdAt(sort: Desc)])
}

model Inventory {
  id                String   @id @default(uuid()) @db.Uuid
  tenantId          String   @db.Uuid
  productId         String   @db.Uuid
  variantId         String?  @db.Uuid
  warehouseId       String   @db.Uuid
  onHand            Int
  reserved          Int      @default(0)
  stockAvailable    Int      @default(dbgenerated("GREATEST((\"onHand\" - \"reserved\"), 0)"))
  lowStockThreshold Int      @default(5)
  version           Int      @default(1)
  updatedAt         DateTime @updatedAt

  @@unique([tenantId, productId, warehouseId, variantId])
  @@index([tenantId, productId, variantId])
}

model ProductVariant {
  id          String   @id @default(uuid()) @db.Uuid
  tenantId    String   @db.Uuid
  productId   String   @db.Uuid
  sku         String
  name        String
  priceMinor  BigInt
  currency    String   @default("GBP")
  packSize    String?
  weightGrams Int?
  abv         Decimal? @db.Decimal(4, 2)
  flavour     String?
  attributes  Json
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([tenantId, sku])
  @@index([tenantId, productId, active])
}

model AttributeSet {
  id          String   @id @default(uuid()) @db.Uuid
  tenantId    String   @db.Uuid
  key         String
  name        String
  definitions Json
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([tenantId, key])
  @@index([tenantId])
}

model ProductAttribute {
  id             String @id @default(uuid()) @db.Uuid
  tenantId       String @db.Uuid
  productId      String @db.Uuid
  attributeSetId String @db.Uuid
  values         Json

  @@unique([tenantId, productId, attributeSetId])
  @@index([tenantId, attributeSetId])
}

model InventoryTransaction {
  id          String          @id @default(uuid()) @db.Uuid
  tenantId    String          @db.Uuid
  inventoryId String          @db.Uuid
  reason      InventoryReason
  quantity    Int
  reference   String?
  actorId     String?         @db.Uuid
  createdAt   DateTime        @default(now())

  @@index([tenantId, inventoryId, createdAt(sort: Desc)])
  @@index([tenantId, reason, createdAt(sort: Desc)])
}

model ImportJob {
  id              String       @id @default(uuid()) @db.Uuid
  tenantId        String       @db.Uuid
  type            String
  status          ImportStatus @default(PENDING)
  duplicatePolicy String
  dryRun          Boolean
  sourceFilename  String
  totalRows       Int          @default(0)
  validRows       Int          @default(0)
  invalidRows     Int          @default(0)
  result          Json?
  createdById     String       @db.Uuid
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  @@index([tenantId, status, createdAt(sort: Desc)])
}

model ImportError {
  id          String  @id @default(uuid()) @db.Uuid
  tenantId    String  @db.Uuid
  importJobId String  @db.Uuid
  rowNumber   Int
  field       String?
  code        String
  message     String
  input       Json

  @@index([tenantId, importJobId, rowNumber])
}

model Warehouse {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String   @db.Uuid
  code      String
  name      String
  address   Json
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([tenantId, code])
  @@index([tenantId])
}

model SearchSynonym {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String   @db.Uuid
  terms     String[]
  enabled   Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId, enabled])
}

model SearchLog {
  id             String   @id @default(uuid()) @db.Uuid
  tenantId       String   @db.Uuid
  userId         String?  @db.Uuid
  query          String
  filters        Json
  resultCount    Int
  responseTimeMs Int
  createdAt      DateTime @default(now())

  @@index([tenantId, query, createdAt(sort: Desc)])
  @@index([tenantId, resultCount, createdAt(sort: Desc)])
}

model Cart {
  id          String     @id @default(uuid()) @db.Uuid
  tenantId    String     @db.Uuid
  userId      String?    @db.Uuid
  guestToken  String?
  couponCode  String?
  status      CartStatus @default(ACTIVE)
  currency    String     @default("GBP")
  version     Int        @default(1)
  expiresAt   DateTime?
  abandonedAt DateTime?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  @@index([tenantId, userId, status])
  @@index([tenantId, guestToken, status])
}

model CartItem {
  id                     String                 @id @default(uuid()) @db.Uuid
  tenantId               String                 @db.Uuid
  cartId                 String                 @db.Uuid
  productId              String                 @db.Uuid
  quantity               Int
  orderCategory          OrderCategory
  substitutionPreference SubstitutionPreference @default(SIMILAR)
  priceSnapshotMinor     BigInt
  snapshotAgeRestriction Int
  snapshotStaleAt        DateTime
  currency               String                 @default("GBP")
  createdAt              DateTime               @default(now())
  updatedAt              DateTime               @updatedAt

  @@unique([tenantId, cartId, productId])
  @@index([tenantId, cartId])
}

model AgeVerification {
  id                  String                @id @default(uuid()) @db.Uuid
  tenantId            String                @db.Uuid
  userId              String?               @db.Uuid
  guestToken          String?
  provider            String
  providerSessionId   String
  status              AgeVerificationStatus @default(PENDING)
  verifiedAgeOver     Int?
  method              AgeVerificationMethod
  providerRef         String?
  verifiedAt          DateTime?
  expiresAt           DateTime?
  declaredDateOfBirth DateTime?             @db.Date
  createdAt           DateTime              @default(now())
  updatedAt           DateTime              @updatedAt

  @@unique([tenantId, provider, providerSessionId])
  @@index([tenantId, userId, status, expiresAt])
  @@index([tenantId, guestToken, status, expiresAt])
}

model DeliveryZone {
  id                          String        @id @default(uuid()) @db.Uuid
  tenantId                    String        @db.Uuid
  code                        String
  name                        String
  postcodePatterns            String[]
  postcodeIncludes            String[]      @default([])
  postcodeExcludes            String[]      @default([])
  deliveryFeeMinor            BigInt
  groceryFeeMinor             BigInt
  alcoholFeeMinor             BigInt
  freeDeliveryThresholdMinor  BigInt?
  minimumOrderMinor           BigInt?
  maximumOrderMinor           BigInt?
  alcoholMinimumSubtotalMinor BigInt?
  feeSchedule                 Json          @default("[]")
  supportedStorageTypes       StorageType[] @default([AMBIENT, CHILLED, FROZEN])
  currency                    String        @default("GBP")
  alcoholDeliveryAllowed      Boolean       @default(true)
  active                      Boolean       @default(true)
  createdAt                   DateTime      @default(now())
  updatedAt                   DateTime      @updatedAt

  @@unique([tenantId, code])
  @@index([tenantId, active])
}

model DeliverySlot {
  id                  String   @id @default(uuid()) @db.Uuid
  tenantId            String   @db.Uuid
  zoneId              String   @db.Uuid
  startsAt            DateTime
  endsAt              DateTime
  capacity            Int
  reserved            Int      @default(0)
  surchargeMinor      BigInt   @default(0)
  cutoffMinutes       Int      @default(120)
  allowsAgeRestricted Boolean  @default(true)
  active              Boolean  @default(true)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  @@unique([tenantId, zoneId, startsAt, endsAt])
  @@index([tenantId, zoneId, startsAt])
}

model DeliverySlotReservation {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String   @db.Uuid
  slotId    String   @db.Uuid
  cartId    String   @db.Uuid
  createdAt DateTime @default(now())

  @@unique([tenantId, cartId])
  @@index([tenantId, slotId])
}

model Coupon {
  id                    String          @id @default(uuid()) @db.Uuid
  tenantId              String          @db.Uuid
  code                  String
  type                  PromotionType
  valueBps              Int?
  valueMinor            BigInt?
  currency              String          @default("GBP")
  minimumSpendMinor     BigInt?
  maximumDiscountMinor  BigInt?
  startsAt              DateTime
  endsAt                DateTime
  maxUses               Int?
  uses                  Int             @default(0)
  couponClass           CouponClass     @default(SITE_WIDE)
  appliesTo             CouponAppliesTo @default(BOTH)
  perCustomerLimit      Int?
  firstOrderOnly        Boolean         @default(false)
  productIds            String[]        @default([]) @db.Uuid
  categoryIds           String[]        @default([]) @db.Uuid
  brandIds              String[]        @default([]) @db.Uuid
  influencerId          String?         @db.Uuid
  lockedUserId          String?         @db.Uuid
  returnRequestId       String?         @db.Uuid
  attributionWindowDays Int             @default(30)
  commissionBasis       String          @default("NET_EX_VAT_DELIVERY")
  active                Boolean         @default(true)
  createdAt             DateTime        @default(now())
  updatedAt             DateTime        @updatedAt

  @@unique([tenantId, code])
  @@index([tenantId, active, startsAt, endsAt])
}

model CouponRedemption {
  id            String   @id @default(uuid()) @db.Uuid
  tenantId      String   @db.Uuid
  couponId      String   @db.Uuid
  userId        String?  @db.Uuid
  guestToken    String?
  orderId       String?  @db.Uuid
  discountMinor BigInt
  attributedAt  DateTime @default(now())
  createdAt     DateTime @default(now())

  @@index([tenantId, couponId, createdAt])
  @@index([tenantId, userId, couponId])
  @@index([tenantId, guestToken, couponId])
}

model CheckoutSession {
  id             String                @id @default(uuid()) @db.Uuid
  tenantId       String                @db.Uuid
  cartId         String                @db.Uuid
  userId         String?               @db.Uuid
  guestToken     String?
  guestUserId    String?               @db.Uuid
  deliverySlotId String?               @db.Uuid
  snapshot       Json
  snapshotHash   String
  currency       String                @default("GBP")
  totalMinor     BigInt
  status         CheckoutSessionStatus @default(ACTIVE)
  expiresAt      DateTime
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt

  @@index([tenantId, cartId, status])
  @@index([tenantId, userId, status])
  @@index([tenantId, guestToken, status])
  @@index([tenantId, status, expiresAt])
}

model CheckoutPaymentIntent {
  id                      String   @id @default(uuid()) @db.Uuid
  tenantId                String   @db.Uuid
  checkoutSessionId       String   @db.Uuid
  provider                String
  providerPaymentIntentId String   @unique
  clientSecret            String
  status                  String
  amountMinor             BigInt
  checkoutTotalMinor      BigInt
  currency                String
  manualCapture           Boolean
  reservedOrderNumber     BigInt
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt

  @@unique([tenantId, checkoutSessionId])
  @@index([tenantId, status])
}

model StockReservation {
  id                String    @id @default(uuid()) @db.Uuid
  tenantId          String    @db.Uuid
  checkoutSessionId String    @db.Uuid
  inventoryId       String    @db.Uuid
  productId         String    @db.Uuid
  quantity          Int
  expiresAt         DateTime
  releasedAt        DateTime?
  createdAt         DateTime  @default(now())

  @@unique([tenantId, checkoutSessionId, productId, inventoryId])
  @@index([tenantId, checkoutSessionId, releasedAt])
  @@index([tenantId, expiresAt, releasedAt])
}

model TaxRule {
  id            String      @id @default(uuid()) @db.Uuid
  tenantId      String      @db.Uuid
